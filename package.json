{
  "name": "atomic-lovable",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "web": "vite",
    "models": "node scripts/models.mjs",
    "models:install": "node scripts/models.mjs --install",
    "serve": "node scripts/serve.mjs",
    "stop": "node scripts/stop.mjs",
    "build": "vite build",
    "dist": "npm run build && node scripts/runtime.mjs --if-missing && electron-builder --mac",
    "runtime": "node scripts/runtime.mjs",
    "icon": "electron scripts/icon.cjs"
  },
  "dependencies": {
    "@webcontainer/api": "^1.6.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "electron@33.4.11": true
  },
  "main": "electron/main.cjs",
  "description": "Prompt → running app, generated by a local coding model and built in a WebContainer sandbox.",
  "build": {
    "appId": "app.atomic.lovable",
    "productName": "Atomic Lovable",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "darkModeSupport": true,
      "minimumSystemVersion": "13.0",
      "identity": null
    },
    "dmg": {
      "title": "Atomic Lovable ${version}",
      "window": {
        "width": 520,
        "height": 340
      }
    },
    "extraResources": [
      {
        "from": "vendor/llama/llama-b11067",
        "to": "llama",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
