{
  "name": "jemero",
  "productName": "Jemero",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "start": "node scripts/kits.mjs --if-stale && node scripts/dev-name.mjs && electron .",
    "web": "node scripts/kits.mjs --if-stale && vite",
    "kits": "node scripts/kits.mjs",
    "packs": "node scripts/kits.mjs --if-stale && node scripts/packs.mjs",
    "packs:keygen": "node scripts/pack-keygen.mjs",
    "models": "node scripts/models.mjs",
    "models:install": "node scripts/models.mjs --install",
    "serve": "node scripts/serve.mjs",
    "stop": "node scripts/stop.mjs",
    "build": "node scripts/kits.mjs --if-stale && vite build",
    "dist": "npm run build && node scripts/runtime.mjs --if-missing && electron-builder --mac --config electron-builder.config.cjs",
    "runtime": "node scripts/runtime.mjs",
    "icon": "electron scripts/icon.cjs",
    "dmg:background": "electron scripts/dmg-background.cjs",
    "e2e:offline": "node scripts/e2e-offline.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@tailwindcss/browser": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.21.5",
    "input-otp": "^1.5.0",
    "katex": "^0.18.7",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "radix-ui": "^1.6.7",
    "react-day-picker": "^9.14.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "electron@44.4.4": true
  },
  "main": "electron/main.cjs",
  "description": "Jemero: a component studio on a local model. Describe a component, block or section; it renders live on an offline canvas with the UI kit you pick. Native macOS, Apple Silicon."
}
