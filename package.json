{
  "name": "jemero",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "web": "vite",
    "models": "node scripts/models.mjs",
    "models:install": "node scripts/models.mjs --install",
    "serve": "node scripts/serve.mjs",
    "stop": "node scripts/stop.mjs",
    "build": "vite build",
    "dist": "npm run build && node scripts/runtime.mjs --if-missing && electron-builder --mac --config electron-builder.config.cjs",
    "runtime": "node scripts/runtime.mjs",
    "icon": "electron scripts/icon.cjs",
    "dmg:background": "electron scripts/dmg-background.cjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@headlessui/react": "^2.2.10",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@mui/material": "^7.3.11",
    "@tailwindcss/browser": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.21.5",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "radix-ui": "^1.6.7",
    "react-day-picker": "^9.14.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "electron@33.4.11": true
  },
  "main": "electron/main.cjs",
  "description": "Jemero: describe an app, a local model builds it. Native macOS, runs fully offline on Apple Silicon."
}
