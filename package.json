{
  "name": "jemero",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "web": "vite",
    "models": "node scripts/models.mjs",
    "models:install": "node scripts/models.mjs --install",
    "serve": "node scripts/serve.mjs",
    "stop": "node scripts/stop.mjs",
    "build": "vite build",
    "dist": "npm run build && node scripts/runtime.mjs --if-missing && electron-builder --mac --config electron-builder.config.cjs",
    "runtime": "node scripts/runtime.mjs",
    "icon": "electron scripts/icon.cjs",
    "dmg:background": "electron scripts/dmg-background.cjs"
  },
  "dependencies": {
    "@webcontainer/api": "^1.6.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "electron@33.4.11": true
  },
  "main": "electron/main.cjs",
  "description": "Jemero — describe an app, a local model builds it. Native macOS, runs fully offline on Apple Silicon."
}
