# Dependencies
node_modules/

# Build output: `npm run build` / `npm run dist` regenerate these
dist/
release/
# The canvas's kit bundles (7 MB), rebuilt by `npm run kits` from kits/
public/kits/
# Downloadable packs, rebuilt and signed by `npm run packs`
packs-dist/
*.tsbuildinfo
.vite/

# The llama.cpp runtime is a 24 MB third-party binary: fetched, not committed.
# `npm run runtime` vendors it; `npm run dist` does so automatically if missing.
vendor/

# Model weights and partial downloads, should any end up in the tree
*.gguf
*.gguf.part
*.part

# Icon build scratch (build/icon.icns and build/icon.png are committed)
build/icon.iconset

# Logs and debug output
*.log
npm-debug.log*
logs/

# Environment and secrets
# The pack signing key (npm run packs:keygen). Never commit it.
.keys/
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.provisionprofile

# Editors, OS and local tool state
.DS_Store
.vscode/
.idea/
*.swp
.kilo/
.claude/settings.local.json

# Local verification screenshots
output/
